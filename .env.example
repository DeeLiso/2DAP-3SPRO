# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Every value here is a placeholder, not a working credential.

# Django
DEBUG=False
SECRET_KEY=generate-a-long-random-value
ALLOWED_HOSTS=your-domain.example.com

# Database: leave DATABASE_URL and DB_ENGINE unset for local SQLite.
# Hosted Postgres (Neon, Supabase, Railway) - paste the connection string here.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_ENGINE=postgres

# Or discrete fields instead of a URL.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432

# MySQL
# DB_ENGINE=mysql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306
